#!/bin/sh

# Adapt these values before merging this into /etc/libvirt/hooks/qemu.
VM_NAME="YOUR_VM_NAME"
SHM_FILE="/dev/shm/looking-glass"
SHM_SIZE_BYTES="134217728"
QEMU_USER="libvirt-qemu"
CLIENT_GROUP="YOUR_USER_PRIVATE_GROUP"

[ "$1" = "$VM_NAME" ] && [ "$2" = "started" ] || exit 0

# Wait briefly for libvirt/QEMU to create the shared-memory file.
i=0
while [ ! -e "$SHM_FILE" ] && [ "$i" -lt 10 ]; do
  sleep 1
  i=$((i + 1))
done

# Refuse missing files, symlinks or an unexpected size.
if [ ! -f "$SHM_FILE" ] || [ -L "$SHM_FILE" ] ||
   [ "$(stat -c %s "$SHM_FILE" 2>/dev/null)" != "$SHM_SIZE_BYTES" ]; then
  logger -t looking-glass-hook "Invalid or missing $SHM_FILE"
  exit 1
fi

# Keep a system user as owner so logind does not remove the file at logout.
# The client's private group provides read-write access.
chown "$QEMU_USER:$CLIENT_GROUP" "$SHM_FILE" &&
  chmod 0660 "$SHM_FILE"
